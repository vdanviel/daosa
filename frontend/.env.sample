# URL base usada pelo SPA (relativa -> passa pelo proxy em /api/*)
NEXT_PUBLIC_API_URL="/api"
# Google Picker (seção Documentos do formulário de agente)
# Requer a Google Picker API habilitada no Console do Google Cloud.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=""
NEXT_PUBLIC_GOOGLE_API_KEY=""
# Destino real do backend, lido pelo proxy (route handler /api/[...path])
# Em dev local: http://localhost:3001
BACKEND_URL="http://backend-daosa:3000"
